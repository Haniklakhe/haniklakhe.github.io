node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# Claude Code local/ephemeral state (launch.json is fine to keep, this isn't)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# personal source documents (contain info deliberately excluded from the public site,
# e.g. phone number/address) — kept locally only, never committed
/_private/

# scratch output from Claude sessions (screenshots, preview builds)
/Claude outputs/

# motion/: render output and the terrain copy made by `npm run sync`
/motion/out/
/motion/src/terrain.ts

# typescript
*.tsbuildinfo
next-env.d.ts
